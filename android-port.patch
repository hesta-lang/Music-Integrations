diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,8 +1,10 @@
 cmake_minimum_required(VERSION 3.21)
 set(CMAKE_CXX_STANDARD 23)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
 if ("${CMAKE_SYSTEM_NAME}" STREQUAL "iOS" OR IOS)
   set(CMAKE_OSX_ARCHITECTURES "arm64")
-else()
+elseif (WIN32 OR "${CMAKE_SYSTEM_NAME}" STREQUAL "Darwin")
   set(CMAKE_OSX_ARCHITECTURES "arm64;x86_64")
 endif()
 set(CMAKE_CXX_VISIBILITY_PRESET hidden)
@@ -31,8 +33,8 @@ endif()

 add_subdirectory($ENV{GEODE_SDK} ${CMAKE_CURRENT_BINARY_DIR}/geode)

-# Link against windowsapp.lib
 add_subdirectory(src/server)

 setup_geode_mod(${PROJECT_NAME})

-if ("${CMAKE_SYSTEM_NAME}" STREQUAL "Windows" OR WIN32)
+if (WIN32 OR "${CMAKE_SYSTEM_NAME}" STREQUAL "Windows")
   target_link_libraries(${PROJECT_NAME} windowsapp http_server)
 else()
   target_link_libraries(${PROJECT_NAME} http_server)
 endif()
diff --git a/src/main.cpp b/src/main.cpp
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -140,6 +140,34 @@ class $modify(CCScene) {
     int getHighestChildZ() {
         if(auto mco = CCScene::get()->getChildByType<MusicControlOverlay>(0)) {
             mco->setZOrder(0);
             int result = CCScene::getHighestChildZ();
             result > 130 ? mco->setZOrder(result) : mco->setZOrder(130);
             return result;
         } else {
             return CCScene::getHighestChildZ();
         }
     }
+
+#ifdef GEODE_IS_ANDROID
+    void onEnter() {
+        CCScene::onEnter();
+        // Android has no physical keyboard by default, so provide a touch entry point.
+        if (this->getChildByID("music-integrations-touch-open")) return;
+        auto menu = CCMenu::create();
+        if (!menu) return;
+        menu->setID("music-integrations-touch-open");
+        auto icon = CCSprite::createWithSpriteFrameName("GJ_playMusicBtn_001.png");
+        if (!icon) icon = CCSprite::create("default.png"_spr);
+        auto item = CCMenuItemSpriteExtra::create(
+            icon, this, menu_selector(CCScene::onMusicIntegrationsTouch)
+        );
+        if (!item) return;
+        menu->addChild(item);
+        menu->setPosition({30.f, CCDirector::sharedDirector()->getWinSize().height - 30.f});
+        this->addChild(menu, 999);
+    }
+
+    void onMusicIntegrationsTouch(CCObject*) {
+        static bool visible = false;
+        visible = !visible;
+        if (auto overlay = MusicControlOverlay::get()) {
+            overlay->updateValues(visible);
+        }
+    }
+#endif
 };
